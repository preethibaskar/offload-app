# --- Used by the frontend (safe to expose in the browser) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Used ONLY by scripts/invite.js, run locally. Never commit this. ---
# Also set on Vercel (as a server-only env var) for api/sort.js's auth check.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Used ONLY by api/sort.js on Vercel. Never exposed to the browser. ---
ANTHROPIC_API_KEY=your-anthropic-api-key
