# --- Used by the frontend (safe to expose in the browser) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Used ONLY by scripts/invite.js, run locally. Never commit this. ---
# Also set on Vercel (server-only) for api/login.js and api/sort.js.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: separate secret for deriving login passwords (defaults to service role key).
# LOGIN_SECRET=your-long-random-string

# --- Used ONLY by api/sort.js on Vercel. Never exposed to the browser. ---
ANTHROPIC_API_KEY=your-anthropic-api-key
