# --- Used by the frontend build (safe to expose in the browser) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Recommended duplicates for Vercel API routes (/api/login, /api/sort) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only. Never commit. Set on Vercel for api/login.js and api/sort.js ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: separate secret for deriving login passwords (defaults to service role key).
# LOGIN_SECRET=your-long-random-string

# --- Used ONLY by api/sort.js on Vercel. Never exposed to the browser. ---
ANTHROPIC_API_KEY=your-anthropic-api-key
